# Operation Kill Switch — frontend env template
# Copy to .env. Only public values here — the anon key is safe to ship
# (all tables are RLS-locked to the service role; access goes through edge
# functions). Real secrets live in Supabase Vault.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — Cloudflare Turnstile public site key. When set, the sign-up form
# renders a bot check and the `wall` edge function enforces it. Leave blank to
# disable. The matching TURNSTILE_SECRET goes in Supabase Vault, never here.
VITE_TURNSTILE_SITE_KEY=
